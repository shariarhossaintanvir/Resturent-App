# ==============================================================================
# FeastHub Production Security Environment Configuration Template
# ==============================================================================
# NOTE: Never commit .env or .env.local to version control.
# Generate a strong 64-character secret in production using:
#   openssl rand -hex 32
# ==============================================================================

# Session & Authentication Secret (Server-only, NEVER expose via NEXT_PUBLIC_)
SESSION_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Production Database Credentials (when upgrading from in-memory/demo)
# DATABASE_URL=postgresql://feasthub_user:password@localhost:5432/feasthub_prod?sslmode=require

# Payment Gateway Secret Keys (when integrating production SSLCommerz / bKash / Stripe)
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
